---
import '../styles/global.css';
import { t, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const {
  lang = 'zh',
  title = t[lang].meta.title,
  description = t[lang].meta.desc,
} = Astro.props;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script
      defer
      src="https://vibeloft.ai/telemetry/v1.js"
      data-vl-product-id="1a08160f-4949-42c9-9773-28507b8837f4"
      data-vl-auth-key="vl_web.FnPFvU-roK2w9C46EYhEsT1vg8btPZytVJwglhPYpY4"
    ></script>
    <script is:inline>
      // Apply saved theme before first paint to avoid flash
      const saved = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved === 'dark' || (!saved && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <script is:inline>
      // Scroll-triggered reveal for .reveal elements
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal, .marker-underline').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
