---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import BentoCard from './BentoCard.astro';
import InteractiveWorkbench from './workbench/InteractiveWorkbench';
import DownloadButtons from './DownloadButtons';
import { t, type Lang } from '../data/i18n';
import {
  NotebookPen, PenTool, Sparkles, Link2, ImageDown, Search,
  Layers, MessagesSquare, ArrowRight, Wand2, FileImage, MousePointerClick,
} from 'lucide-react';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = t[lang];

const workflowIcons = [MousePointerClick, PenTool, FileImage];
const workflowColors = [
  'bg-note-blue/50 text-blue-600 dark:text-blue-400',
  'bg-note-green/60 text-green-600 dark:text-green-400',
  'bg-note-yellow/70 text-yellow-700 dark:text-yellow-400',
];

const copy = lang === 'zh'
  ? {
      notes: {
        title: '笔记 · 长文创作中心',
        desc: 'CodeMirror 6 双模编辑，直连 Obsidian 目录。Live Preview 实时预览、Wikilink 双链补全、图片拖拽排版，原生兼容 .canvas 与 Excalidraw。',
      },
      agent: {
        title: 'AI Agent 嵌入式面板',
        desc: '感知当前文章、选中笔记或画板元素。灵感发散、跨笔记混合推理、结构化扩写，流式打字机响应。',
        actions: ['为本段配图', '提炼反直觉观点', '生成对比矩阵'],
      },
      studio: {
        title: '创作 · 无限画板设计台',
        desc: '基于 Excalidraw 深度定制。手绘风素材抽屉、架构组件、便签胶带、场景模板，拖拽即用——配图是逻辑的外化，不是油腻的 AI 插图。',
      },
      pipeline: {
        title: '一键插入文章',
        desc: '画板导出高清 PNG/SVG，自动存入 Obsidian 资产目录，光标处自动打入 Markdown 引用。全程 1 秒，无需跳出。',
        steps: ['画板', 'PNG', '![[…]]'],
      },
      search: {
        title: '穿透双链网络',
        descA: '搜索与检索穿透',
        descB: '与 .canvas 结构，概念、引用、画板资产交叉归纳。',
      },
      local: {
        title: '本地优先，尊重资产',
        desc: '直接读写你的 Vault，删除走系统回收站，不做任何中间数据库的暗箱篡改。你的笔记永远是你的。',
      },
      session: {
        title: '多会话并发不串台',
        desc: '后台会话静默生成，随时切入承接打字流。写作问 AI、画板调 Agent，互不干扰。',
      },
    }
  : {
      notes: {
        title: 'Notes · Long-form writing hub',
        desc: 'CodeMirror 6 dual-mode editing, wired straight into your Obsidian vault. Live Preview, Wikilink completion, drag-to-place images, native .canvas and Excalidraw support.',
      },
      agent: {
        title: 'Embedded AI Agent panel',
        desc: 'Aware of the current article, selected notes or board elements. Brainstorming, cross-note hybrid reasoning, structured expansion — streamed like a typewriter.',
        actions: ['Illustrate this section', 'Distil counter-intuitive takes', 'Build a comparison matrix'],
      },
      studio: {
        title: 'Studio · Infinite design board',
        desc: 'Deeply customized on Excalidraw. Hand-drawn material drawer, architecture components, sticky tapes and scene templates — illustrations are your logic made visible, not greasy AI art.',
      },
      pipeline: {
        title: 'One-click insert',
        desc: 'The board exports a crisp PNG/SVG into your vault assets folder and stamps the Markdown reference at your cursor. One second, no app-switching.',
        steps: ['Board', 'PNG', '![[…]]'],
      },
      search: {
        title: 'Through the backlink graph',
        descA: 'Search and retrieval cut through',
        descB: 'and .canvas structures — concepts, references and board assets cross-correlated.',
      },
      local: {
        title: 'Local-first, asset-respecting',
        desc: 'Reads and writes your vault directly. Deletes go to the system trash — no hidden intermediate database mutating your files. Your notes stay yours.',
      },
      session: {
        title: 'Concurrent sessions, no cross-talk',
        desc: 'Background sessions stream silently; jump in any time to pick up the flow. Ask AI while writing, drive the Agent on the board — never interfering.',
      },
    };
---

<BaseLayout lang={lang} title={i.meta.title} description={i.meta.desc}>
  <Navbar lang={lang} />

  <!-- ── Hero ── -->
  <section class="dot-grid relative overflow-hidden border-b border-border">
    <div class="mx-auto max-w-6xl px-6 pt-20 pb-16 text-center md:pt-28">
      <div class="animate-fade-up inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground shadow-2xs">
        <Sparkles size={13} className="text-amber-500" />
        {i.hero.badge}
      </div>

      <h1 class="animate-fade-up mx-auto mt-7 max-w-3xl text-4xl leading-[1.15] font-bold tracking-tight md:text-6xl" style="animation-delay: 80ms">
        {i.hero.titleA}{' '}<span class="marker-underline">{i.hero.titleHighlight}</span><br />
        {i.hero.titleB}
      </h1>

      <p class="animate-fade-up mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg" style="animation-delay: 160ms">
        {i.hero.sub}
      </p>

      <div class="animate-fade-up mt-9 flex justify-center" style="animation-delay: 240ms">
        <DownloadButtons client:load lang={lang} />
      </div>

      <!-- Interactive workbench: a working miniature of the desktop app -->
      <div class="animate-fade-up mx-auto mt-16 max-w-4xl" style="animation-delay: 340ms">
        <InteractiveWorkbench client:only="react" lang={lang} />
        <p class="mt-4 text-xs text-muted-foreground/70">{i.hero.caption}</p>
      </div>
    </div>
  </section>

  <!-- ── Bento: two core modules ── -->
  <section id="features" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="reveal mb-12 text-center">
      <p class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">{i.features.kicker}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">{i.features.title}</h2>
    </div>

    <div class="grid gap-4 md:grid-cols-6">
      <!-- Notes module: large card -->
      <BentoCard class="md:col-span-4 flex flex-col">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-note-blue/50 text-blue-600 dark:text-blue-400">
          <NotebookPen size={20} />
        </div>
        <h3 class="text-lg font-semibold">{copy.notes.title}</h3>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">{copy.notes.desc}</p>
        <!-- mini editor mock -->
        <div class="mt-6 flex-1 rounded-lg border border-border bg-muted/40 p-4 font-mono text-xs leading-6">
          <p class="text-zinc-400">## {lang === 'zh' ? '反直觉的架构决策' : 'Counter-intuitive architecture decisions'}</p>
          <p class="text-foreground">{lang === 'zh' ? '稳定性的代价，往往藏在' : 'The cost of stability hides in'}<span class="text-indigo-500">[[{lang === 'zh' ? '幂等设计' : 'idempotency'}]]</span>{lang === 'zh' ? '里。' : '.'}</p>
          <p class="text-zinc-400">![[{lang === 'zh' ? '架构演进图.excalidraw' : 'architecture-evolution.excalidraw'}]]</p>
          <p class="text-foreground">{lang === 'zh' ? '当重试风暴来临时…' : 'When the retry storm hits…'}<span class="ml-0.5 inline-block h-3 w-px animate-blink bg-zinc-500 align-middle"></span></p>
        </div>
      </BentoCard>

      <!-- AI agent -->
      <BentoCard class="md:col-span-2" delay={80}>
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-note-purple/60 text-purple-600 dark:text-purple-400">
          <MessagesSquare size={20} />
        </div>
        <h3 class="text-lg font-semibold">{copy.agent.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{copy.agent.desc}</p>
        <div class="mt-5 space-y-2">
          {copy.agent.actions.map((action) => (
            <div class="flex items-center gap-2 rounded-lg bg-muted px-3 py-2 text-xs text-muted-foreground transition-transform hover:translate-x-1">
              <Wand2 size={12} className="shrink-0 text-purple-500" />{action}
            </div>
          ))}
        </div>
      </BentoCard>

      <!-- Studio module: large card -->
      <BentoCard class="md:col-span-4 flex flex-col" delay={80}>
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-note-green/60 text-green-600 dark:text-green-400">
          <PenTool size={20} />
        </div>
        <h3 class="text-lg font-semibold">{copy.studio.title}</h3>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">{copy.studio.desc}</p>
        <!-- sticky notes mock -->
        <div class="mt-6 flex flex-1 flex-wrap items-start gap-3">
          <div class="w-32 -rotate-2 rounded-md bg-note-yellow p-3 text-[11px] leading-snug text-yellow-900 shadow-sm transition-transform hover:rotate-0 hover:scale-105">Goal: 30% less planning time</div>
          <div class="w-32 rotate-1 rounded-md bg-note-blue p-3 text-[11px] leading-snug text-blue-900 transition-transform hover:rotate-0 hover:scale-105">Undo a reroute in one tap?</div>
          <div class="w-32 -rotate-1 rounded-md bg-note-pink p-3 text-[11px] leading-snug text-pink-900 transition-transform hover:rotate-0 hover:scale-105">Drivers replan stops by hand</div>
          <div class="w-32 rotate-2 rounded-md bg-note-green p-3 text-[11px] leading-snug text-green-900 transition-transform hover:rotate-0 hover:scale-105">Beta: 200 drivers, Wed 4 Nov</div>
        </div>
      </BentoCard>

      <!-- insert pipeline -->
      <BentoCard class="md:col-span-2" delay={160}>
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-note-yellow/70 text-yellow-700 dark:text-yellow-400">
          <ImageDown size={20} />
        </div>
        <h3 class="text-lg font-semibold">{copy.pipeline.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{copy.pipeline.desc}</p>
        <div class="mt-5 flex items-center gap-2 text-[11px] font-medium text-muted-foreground">
          <span class="rounded-md border border-border bg-muted px-2 py-1">{copy.pipeline.steps[0]}</span>
          <ArrowRight size={12} className="shrink-0" />
          <span class="rounded-md border border-border bg-muted px-2 py-1">{copy.pipeline.steps[1]}</span>
          <ArrowRight size={12} className="shrink-0" />
          <span class="rounded-md border border-border bg-muted px-2 py-1">{copy.pipeline.steps[2]}</span>
        </div>
      </BentoCard>

      <!-- search -->
      <BentoCard class="md:col-span-2">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-muted text-muted-foreground">
          <Search size={20} />
        </div>
        <h3 class="text-lg font-semibold">{copy.search.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          {copy.search.descA} <code class="rounded bg-muted px-1 py-0.5 text-[11px]">[[{lang === 'zh' ? '双链' : 'backlinks'}]]</code> {copy.search.descB}
        </p>
      </BentoCard>

      <!-- local first -->
      <BentoCard class="md:col-span-2" delay={80}>
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-muted text-muted-foreground">
          <Layers size={20} />
        </div>
        <h3 class="text-lg font-semibold">{copy.local.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{copy.local.desc}</p>
      </BentoCard>

      <!-- multi-session -->
      <BentoCard class="md:col-span-2" delay={160}>
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-muted text-muted-foreground">
          <Link2 size={20} />
        </div>
        <h3 class="text-lg font-semibold">{copy.session.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{copy.session.desc}</p>
      </BentoCard>
    </div>
  </section>

  <!-- ── Workflow: three steps ── -->
  <section id="workflow" class="border-y border-border bg-muted/30">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <div class="reveal mb-14 text-center">
        <p class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">{i.workflow.kicker}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">{i.workflow.title}</h2>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {i.workflow.steps.map((s, idx) => {
          const Icon = workflowIcons[idx];
          return (
            <BentoCard delay={idx * 100}>
              <div class="mb-4 flex items-center justify-between">
                <div class={`flex h-10 w-10 items-center justify-center rounded-xl ${workflowColors[idx]}`}>
                  <Icon size={20} />
                </div>
                <span class="font-mono text-4xl font-bold text-zinc-200 dark:text-zinc-800">{`0${idx + 1}`}</span>
              </div>
              <h3 class="text-lg font-semibold">{s.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.d}</p>
            </BentoCard>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Philosophy ── -->
  <section class="mx-auto max-w-3xl px-6 py-20 text-center md:py-28">
    <div class="reveal">
      <p class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">{i.philosophy.kicker}</p>
      <h2 class="mt-4 text-2xl leading-snug font-bold tracking-tight md:text-4xl md:leading-snug">
        {i.philosophy.titleA}<br />
        <span class="marker-underline">{i.philosophy.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted-foreground">
        {i.philosophy.desc}
      </p>
    </div>
  </section>

  <!-- ── Download CTA ── -->
  <section class="border-t border-border">
    <div class="dot-grid mx-auto max-w-6xl px-6 py-20 text-center md:py-28">
      <div class="reveal">
        <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{i.cta.title}</h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">{i.cta.desc}</p>
        <div class="mt-8 flex justify-center">
          <DownloadButtons client:load lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
