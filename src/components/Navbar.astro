---
import ThemeToggle from './ThemeToggle';
import { t, href, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const n = t[lang].nav;
const root = href(lang);

const links = [
  { href: `${root}#features`, label: n.features },
  { href: `${root}#workflow`, label: n.workflow },
  { href: href(lang, 'changelog'), label: n.changelog },
];
const otherLocaleUrl = lang === 'zh' ? '/en/' : '/';
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
    <a href={root} class="flex items-center gap-2.5">
      <img src="/favicon.svg" alt="aitower" class="h-6 w-6 rounded-md" />
      <span class="text-[15px] font-semibold tracking-tight">aitower</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class="rounded-full px-3.5 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          {l.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a
        href={otherLocaleUrl}
        class="rounded-full px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Switch language"
      >
        {lang === 'zh' ? 'EN' : '中'}
      </a>
      <ThemeToggle client:load />
      <a
        href={`${root}#download`}
        class="inline-flex h-8 items-center rounded-full bg-primary px-4 text-[13px] font-medium text-primary-foreground transition-opacity hover:opacity-90"
      >
        {n.download}
      </a>
    </div>
  </nav>
</header>
