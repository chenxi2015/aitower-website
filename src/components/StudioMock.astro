---
// Pure-CSS/TSX-free animated mock of the app's studio three-column layout.
// Hand-drawn flavor: pastel sticky notes + dashed flow arrows.
---

<div class="dot-grid relative h-full w-full overflow-hidden rounded-xl border border-border bg-background p-3 text-left select-none">
  <!-- faux window chrome -->
  <div class="mb-3 flex items-center gap-1.5">
    <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    <span class="ml-2 rounded-md bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground">创作 · 无限画板</span>
  </div>

  <div class="grid h-[calc(100%-2rem)] grid-cols-[84px_1fr_120px] gap-3">
    <!-- left: material drawer -->
    <div class="flex flex-col gap-2 rounded-lg border border-border bg-card p-2">
      <div class="seg-tab-group" style="padding:2px">
        <span class="seg-tab active" style="padding:2px 4px;font-size:9px">素材</span>
        <span class="seg-tab" style="padding:2px 4px;font-size:9px">模板</span>
      </div>
      <div class="grid grid-cols-2 gap-1.5">
        <div class="aspect-square rounded-md border border-border bg-note-yellow/60"></div>
        <div class="aspect-square rounded-md border border-border bg-note-blue/60"></div>
        <div class="aspect-square rounded-md border border-border bg-note-pink/60"></div>
        <div class="aspect-square rounded-md border border-border bg-note-green/60"></div>
      </div>
      <div class="mt-auto h-1.5 rounded-full bg-muted"></div>
      <div class="h-1.5 w-2/3 rounded-full bg-muted"></div>
    </div>

    <!-- center: canvas with animated flow -->
    <div class="relative rounded-lg border border-border bg-card p-2">
      <svg viewBox="0 0 300 190" class="h-full w-full" fill="none">
        <!-- connector with marching dashes -->
        <path d="M78 48 H132" stroke="currentColor" class="text-zinc-400" stroke-width="1.5" stroke-dasharray="5 5" style="animation: dash 2.4s linear infinite" />
        <path d="M196 48 H222 Q238 48 238 64 V78" stroke="currentColor" class="text-zinc-400" stroke-width="1.5" stroke-dasharray="5 5" style="animation: dash 2.4s linear infinite" />
        <path d="M238 118 V132 Q238 148 222 148 H120 Q104 148 104 132 V92" stroke="currentColor" class="text-zinc-300 dark:text-zinc-600" stroke-width="1.5" stroke-dasharray="5 5" style="animation: dash 3.2s linear infinite" />

        <!-- node: start -->
        <g style="animation: float 7s ease-in-out infinite">
          <rect x="18" y="34" width="60" height="28" rx="7" fill="var(--background)" stroke="currentColor" class="text-zinc-500" stroke-width="1.5" />
          <text x="48" y="52" text-anchor="middle" font-size="10" fill="currentColor" class="fill-foreground" font-weight="500">笔记碎片</text>
        </g>

        <!-- sticky note -->
        <g style="animation: float 8s ease-in-out 0.6s infinite">
          <rect x="18" y="96" width="72" height="34" rx="4" fill="#fef08a" stroke="#e5c90a" stroke-width="1" transform="rotate(-2 54 113)" />
          <text x="54" y="111" text-anchor="middle" font-size="8.5" fill="#713f12" transform="rotate(-2 54 113)">反直觉洞察?</text>
          <text x="54" y="122" text-anchor="middle" font-size="8.5" fill="#713f12" transform="rotate(-2 54 113)"></text>
        </g>

        <!-- node: AI -->
        <g style="animation: float 6.5s ease-in-out 0.3s infinite">
          <rect x="132" y="34" width="64" height="28" rx="7" fill="var(--background)" stroke="currentColor" class="text-zinc-500" stroke-width="1.5" />
          <text x="164" y="52" text-anchor="middle" font-size="10" fill="currentColor" class="fill-foreground" font-weight="500">AI 发散</text>
        </g>

        <!-- node: board -->
        <g style="animation: float 7.5s ease-in-out 0.9s infinite">
          <rect x="216" y="92" width="72" height="28" rx="7" fill="#bbf7d0" stroke="#4ade80" stroke-width="1.5" />
          <text x="252" y="110" text-anchor="middle" font-size="10" fill="#14532d" font-weight="500">手绘配图</text>
        </g>

        <!-- blinking caret on canvas -->
        <rect x="140" y="160" width="1.5" height="12" class="fill-zinc-400" style="animation: blink 1.1s step-end infinite" />
        <text x="146" y="170" font-size="9" class="fill-muted-foreground">画板就绪，一键插入文章…</text>
      </svg>
    </div>

    <!-- right: AI agent panel -->
    <div class="flex flex-col gap-2 rounded-lg border border-border bg-card p-2">
      <div class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-[10px] font-semibold">AI 助手</span>
      </div>
      <div class="rounded-md bg-muted px-2 py-1.5 text-[9px] leading-relaxed text-muted-foreground">绘制微服务系统架构图</div>
      <div class="rounded-md bg-muted px-2 py-1.5 text-[9px] leading-relaxed text-muted-foreground">多方案选型对比矩阵</div>
      <div class="rounded-md bg-muted px-2 py-1.5 text-[9px] leading-relaxed text-muted-foreground">概念流转与演进路线</div>
      <div class="mt-auto rounded-md border border-border px-2 py-1 text-[9px] text-muted-foreground/60">
        输入指令…<span class="ml-0.5 inline-block h-2 w-px bg-zinc-400 align-middle" style="animation: blink 1.1s step-end infinite"></span>
      </div>
    </div>
  </div>
</div>
