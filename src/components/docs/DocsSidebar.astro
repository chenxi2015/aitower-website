---
import type { DocNavGroup } from '../../data/docs';

interface Props {
  groups: DocNavGroup[];
  currentSlug: string;
}

const { groups, currentSlug } = Astro.props;
---

<nav aria-label="Documentation navigation" class="space-y-6 text-sm">
  {groups.map((group) => (
    <div>
      <p class="mb-2 px-2 text-xs font-semibold tracking-wider text-muted-foreground uppercase">
        {group.label}
      </p>
      <ul class="space-y-0.5">
        {group.items.map((item) => {
          const active = item.slug === currentSlug;
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex items-center justify-between gap-2 rounded-lg px-2.5 py-1.5 transition-colors',
                  active
                    ? 'bg-muted font-medium text-foreground'
                    : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',
                ]}
              >
                <span class="truncate">{item.title}</span>
                {item.badge && (
                  <span class="shrink-0 rounded-full border border-border bg-background px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                    {item.badge}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
