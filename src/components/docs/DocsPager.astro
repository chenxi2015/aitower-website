---
import type { DocNavItem } from '../../data/docs';
import { t, type Lang } from '../../data/i18n';
import { ArrowLeft, ArrowRight } from 'lucide-react';

interface Props {
  lang: Lang;
  prev: DocNavItem | null;
  next: DocNavItem | null;
}

const { lang, prev, next } = Astro.props;
const copy = t[lang].docsPage;
---

{(prev || next) && (
  <nav
    aria-label="Pagination"
    class="mt-14 grid gap-3 border-t border-border pt-8 sm:grid-cols-2"
  >
    {prev ? (
      <a
        href={prev.href}
        class="group flex flex-col gap-1 rounded-xl border border-border bg-card p-4 transition-colors hover:border-zinc-300 hover:bg-muted/40 dark:hover:border-zinc-700"
      >
        <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
          <ArrowLeft size={12} className="transition-transform group-hover:-translate-x-0.5" />
          {copy.prev}
        </span>
        <span class="text-sm font-medium text-foreground">{prev.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )}

    {next && (
      <a
        href={next.href}
        class="group flex flex-col items-end gap-1 rounded-xl border border-border bg-card p-4 text-right transition-colors hover:border-zinc-300 hover:bg-muted/40 dark:hover:border-zinc-700"
      >
        <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
          {copy.next}
          <ArrowRight size={12} className="transition-transform group-hover:translate-x-0.5" />
        </span>
        <span class="text-sm font-medium text-foreground">{next.title}</span>
      </a>
    )}
  </nav>
)}
