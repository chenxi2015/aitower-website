---
import type { MarkdownHeading } from 'astro';
import { t, type Lang } from '../../data/i18n';

interface Props {
  lang: Lang;
  headings: MarkdownHeading[];
}

const { lang, headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const title = t[lang].docsPage.onThisPage;
---

{tocHeadings.length > 0 && (
  <aside class="hidden xl:block">
    <div class="sticky top-24">
      <p class="mb-3 text-xs font-semibold tracking-wider text-muted-foreground uppercase">
        {title}
      </p>
      <ul class="space-y-1.5 border-l border-border text-xs" data-docs-toc>
        {tocHeadings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                '-ml-px block border-l border-transparent py-0.5 text-muted-foreground transition-colors hover:border-foreground hover:text-foreground',
                h.depth === 2 ? 'pl-3' : 'pl-6',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
)}

<script is:inline>
  // Highlight the active section in the right-hand table of contents on scroll
  (() => {
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (links.length === 0) return;

    const headingEls = links
      .map((link) => document.getElementById(link.getAttribute('data-toc-link') || ''))
      .filter((el) => el !== null);

    if (headingEls.length === 0) return;

    const setActive = (id) => {
      for (const link of links) {
        const active = link.getAttribute('data-toc-link') === id;
        link.classList.toggle('border-foreground', active);
        link.classList.toggle('text-foreground', active);
        link.classList.toggle('font-medium', active);
        link.classList.toggle('border-transparent', !active);
        link.classList.toggle('text-muted-foreground', !active);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((e) => e.isIntersecting);
        if (visible?.target?.id) setActive(visible.target.id);
      },
      { rootMargin: '-88px 0px -65% 0px', threshold: 0 },
    );

    headingEls.forEach((el) => observer.observe(el));
    setActive(headingEls[0].id);
  })();
</script>
