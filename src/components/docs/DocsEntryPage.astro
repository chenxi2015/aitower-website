---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  getDocsByLang,
  getPrevNextDocs,
  getSwitchLocaleDocHref,
  groupDocsBySection,
  type DocNavItem,
} from '../../data/docs';
import type { Lang } from '../../data/i18n';

interface Props {
  lang: Lang;
  item: DocNavItem;
}

const { lang, item } = Astro.props;
const allItems = await getDocsByLang(lang);
const groups = groupDocsBySection(lang, allItems);
const sectionLabel = groups.find((g) => g.id === item.section)?.label ?? item.section;
const { prev, next } = getPrevNextDocs(allItems, item.slug);
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchLocaleUrl = await getSwitchLocaleDocHref(otherLang, item.slug);
const { Content, headings } = await render(item.entry);
---

<DocsLayout
  lang={lang}
  title={item.title}
  description={item.description}
  sectionLabel={sectionLabel}
  currentSlug={item.slug}
  groups={groups}
  headings={headings}
  prev={prev}
  next={next}
  switchLocaleUrl={switchLocaleUrl}
>
  <Content />
</DocsLayout>
